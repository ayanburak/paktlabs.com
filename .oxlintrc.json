{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      // packages/brand/hooks/useReveal.ts bir ref ve bir IntersectionObserver'dan
      // gelen state dondurur. Cagiran bilesenler ref'i bir JSX ozniteligine verir, kural bunu
      // render icinde ref.current okumak sanip isaretliyor, oysa .current'a yalnizca
      // useEffect icinde erisiliyor. Bu yedi dosya hook'un sonucunu kullanan bilesenlerdir.
      "files": [
        "packages/brand/components/Contact.tsx",
        "apps/landing/src/routes/Home/sections/Hero.tsx",
        "apps/landing/src/routes/Home/sections/Work/Work.tsx",
        "apps/landing/src/routes/Home/sections/Work/Band.tsx",
        "apps/data/src/routes/Home/sections/Works/Works.tsx",
        "apps/data/src/routes/Study/sections/Closing.tsx",
        "apps/data/src/components/study/Chapter.tsx"
      ],
      "rules": { "react/refs": "off" }
    },
    {
      // useReveal gorunurlugu azaltilmis harekette efekt icinde acar, DataLanguageProvider
      // site dili degisince veri dili secimini efektte sifirlar. Ikisi de tarayici tercihi
      // ya da dil degistirici gibi dis bir degisikligi state'e esler.
      "files": ["packages/brand/hooks/useReveal.ts", "apps/data/src/components/study/DataLanguageProvider.tsx"],
      "rules": { "react/set-state-in-effect": "off" }
    }
  ]
}
