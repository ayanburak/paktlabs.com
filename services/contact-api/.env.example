# Sunucuda /opt/paktlabs-api/.env bu bicimde yazilir, systemd servisi
# dosyayi ortam degiskeni olarak yukler. Lokalde bu dosya gerekmez,
# CONTACT_MAILER=console vermek yeter ve bildirim terminale yazilir.
# Varsayilan smtp, o zaman SMTP_HOST, SMTP_USER ve SMTP_PASSWORD zorunludur.
# Gercek sifre hicbir zaman repoya girmez.

CONTACT_DB_PATH=/opt/paktlabs-api/data/messages.sqlite3
CONTACT_MAIL_TO=info@paktlabs.com
CONTACT_KEEP_DAYS=730
CONTACT_MAILER=smtp

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@paktlabs.com
SMTP_PASSWORD=
